# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Personal backup files
backup.json
*.backup.json

# Local-only secrets, keystores and store credentials live in local_files/
# (see local_files/README.md). Only the packer script and README are tracked.
local_files/*
!local_files/pack.sh
!local_files/README.md
# Legacy locations of the same files - keep ignored so a stray copy never lands in git
lib/shared/services/google_drive/desktop_oauth_config.dart
**/LOCAL_SETUP.md
android/key.properties
*.jks
*.keystore
play-service-account.json
app_sp_pw
AuthKey_*.p8
asc_issuer

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Flutter/Dart/Pub related
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
pubspec.lock

# Generated files
**/*.g.dart
**/*.freezed.dart
**/*.mocks.dart
**/*.config.dart

# DevTools and metadata
devtools_options.yaml
.metadata

# Large generated image files (but keep custom icons)
feature_graphics.png
# Keep custom icons
# !icon.png
# !Android_icon.png

# Generated/config files
*.iml
google-services_debug.json
google-services_release.json

# Exclude platform directories - but keep essential build config files
# Android - track build configuration files (no secrets - signing key paths only)
android/*
!android/build.gradle.kts
!android/settings.gradle.kts
!android/gradle.properties
!android/app/
android/app/*
!android/app/build.gradle.kts
!android/app/src/
android/app/src/*
!android/app/src/main/
android/app/src/main/*
!android/app/src/main/AndroidManifest.xml

# iOS - track essential config files (no secrets)
ios/*
!ios/Podfile
!ios/Runner/
ios/Runner/*
!ios/Runner/Info.plist
!ios/Runner/AppDelegate.swift
!ios/Runner.xcodeproj/
ios/Runner.xcodeproj/*
!ios/Runner.xcodeproj/project.pbxproj
!ios/Runner.xcodeproj/xcshareddata/
linux/
macos/*
!macos/Podfile
!macos/Runner/
macos/Runner/*
!macos/Runner/Info.plist
!macos/Runner/AppDelegate.swift
!macos/Runner/MainFlutterWindow.swift
!macos/Runner/Assets.xcassets/
!macos/Runner/Base.lproj/
!macos/Runner/Configs/
!macos/Runner/*.entitlements
!macos/Runner.xcodeproj/
macos/Runner.xcodeproj/*
!macos/Runner.xcodeproj/project.pbxproj
!macos/Runner.xcodeproj/xcshareddata/
!macos/Runner.xcworkspace/
macos/Runner.xcworkspace/*
!macos/Runner.xcworkspace/contents.xcworkspacedata
!macos/Runner.xcworkspace/xcshareddata/
windows/

# Web build output and generated files (keep only index.html)
web/
!web/index.html

# Exclude test directories (uncomment if you want to track tests)
# test/

# Coverage files
coverage/
*.lcov

# Environment files
.env
.env.local
.env.*.local

# Only track your core Dart application code in lib/
# Only track your pubspec.yaml
# Only track your assets/ if you have custom assets
# Only track documentation and project files you created
*.apk
